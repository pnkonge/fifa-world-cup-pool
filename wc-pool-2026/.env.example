# Google Sheet published-to-web CSV URLs.
# When all are set the app fetches real data; otherwise it uses mocks.
#
# To get these URLs:
#   1. Open the Google Sheet.
#   2. File → Share → Publish to web.
#   3. Pick the tab from the dropdown, format = CSV, click Publish.
#   4. Copy the URL and paste below.

VITE_SHEET_CSV_RESULTS=
VITE_SHEET_CSV_SCORING=
VITE_SHEET_CSV_STANDINGS=
VITE_SHEET_CSV_SCHEDULE=
VITE_SHEET_CSV_PREDICTIONS_GROUP=
VITE_SHEET_CSV_PREDICTIONS_KO=

# The Google Form 1 share URL (group + wild card + tiebreaker picks).
# Used as the "Submit your picks" button on the dashboard.
VITE_FORM_1_URL=
